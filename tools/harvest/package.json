{
  "name": "@vdp/harvest",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Read-only vehicle harvest: observes addresses, services, DIDs and fault memory and writes them as an observation, an ODX/PDX description and a definition candidate (ADR 0058).",
  "repository": {
    "type": "git",
    "url": "https://github.com/CAZE7/yes-you-CAN.git",
    "directory": "tools/harvest"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "dependencies": {
    "@vdp/adapter-host": "0.1.0",
    "@vdp/core": "0.1.0",
    "@vdp/definitions": "0.1.0",
    "@vdp/protocols-uds": "0.1.0",
    "@vdp/shared": "0.1.0",
    "@vdp/simulators": "0.1.0",
    "@vdp/storage": "0.1.0",
    "@vdp/transport-can": "0.1.0",
    "@vdp/transport-iso-tp": "0.1.0"
  }
}
