{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "off",
        "noUnnecessaryContinue": "error"
      },
      "style": {
        "useImportType": "error",
        "noNonNullAssertion": "error",
        "useTemplate": "off",
        "noUnusedTemplateLiteral": "error",
        "useConst": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsoleLog": "error",
        "noShadowRestrictedNames": "error",
        "noControlCharactersInRegex": "off",
        "noImplicitAnyLet": "error",
        "noAssignInExpressions": "error"
      },
      "complexity": {
        "noForEach": "off",
        "useLiteralKeys": "off"
      },
      "performance": {
        "noDelete": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "include": ["**/*.spec.ts", "**/*.test.ts", "tests/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noAssignInExpressions": "off"
          },
          "style": {
            "noNonNullAssertion": "off",
            "useConst": "off"
          },
          "performance": {
            "noDelete": "off"
          }
        }
      }
    },
    {
      "include": ["scripts/**", "packages/shared/src/logger.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsoleLog": "off"
          }
        }
      }
    }
  ],
  "files": {
    "ignoreUnknown": false,
    "ignore": [
      "node_modules",
      "dist",
      "coverage",
      "sessions-local",
      "*.tsbuildinfo",
      "vitest.config.ts"
    ]
  }
}
