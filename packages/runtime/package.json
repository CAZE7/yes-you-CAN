{
  "name": "@vdp/runtime",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Diagnostic runtime: composes the engine, services, command bus and domain events into one headless API (target architecture ADR 0014).",
  "repository": {
    "type": "git",
    "url": "https://github.com/CAZE7/yes-you-CAN.git",
    "directory": "packages/runtime"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "dependencies": {
    "@vdp/application": "0.1.0",
    "@vdp/core": "0.1.0",
    "@vdp/definitions": "0.1.0",
    "@vdp/domain": "0.1.0",
    "@vdp/protocols-uds": "0.1.0",
    "@vdp/shared": "0.1.0",
    "@vdp/transport-can": "0.1.0",
    "@vdp/transport-doip": "0.1.0"
  }
}
